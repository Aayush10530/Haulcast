# Backend Environment Variables Example
# Copy this file to backend/.env and fill in real values

# Django Settings
DJANGO_SECRET_KEY=django-insecure-change-this-in-production-haulcast-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Provider Configuration
ROUTING_PROVIDER=tomtom
TOMTOM_API_KEY=your_tomtom_api_key_here

# Cache TTLs (seconds)
ROUTE_CACHE_TTL_SECONDS=1800
WEATHER_CACHE_TTL_SECONDS=1800
GEOCODE_CACHE_TTL_SECONDS=86400

# Network & Throttling
HTTP_TIMEOUT_SECONDS=8
THROTTLE_ANALYZE=20/min
LOG_LEVEL=INFO
